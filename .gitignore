# ==========================================================
# Root .gitignore for Monorepo
# Technologies:
# - Java 21
# - Maven
# - Spring Boot
# - Angular
# - Node.js / npm
# - Flutter / Dart
# - Docker
# ==========================================================
# ==========================================================
# Java / Maven
# ==========================================================
**/target/
**/out/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/hs_err_pid*
**/replay_pid*
**/.flattened-pom.xml

# ==========================================================
# Spring Boot
# ==========================================================
**/spring-boot-devtools.properties
**/application-local.properties
**/application-local.yml
**/application-local.yaml

# ==========================================================
# Node.js / npm
# ==========================================================
**/node_modules/
**/.npm/
**/.npmrc.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.yarn/
**/.pnp.*
**/.parcel-cache/
**/.eslintcache
**/.stylelintcache

# ==========================================================
# Angular
# ==========================================================
**/.angular/
**/dist/
**/coverage/
**/.sass-cache/
**/.cache/

# ==========================================================
# Flutter / Dart
# ==========================================================
**/.dart_tool/
**/.pub-cache/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/

**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

**/ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/

**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/.symlinks/

**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

**/web/.dart_tool/

**/*.g.dart
**/*.freezed.dart

# ==========================================================
# IntelliJ IDEA
# ==========================================================
**/.idea/
**/*.iml
**/*.ipr
**/*.iws

# ==========================================================
# Eclipse
# ==========================================================
**/.classpath
**/.project
**/.settings/
**/.factorypath
**/.loadpath
**/bin/

# ==========================================================
# Visual Studio Code
# ==========================================================
.history/
.vscode/
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# ==========================================================
# Operating Systems
# ==========================================================
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*
**/.Spotlight-V100/
**/.Trashes/

**/ehthumbs.db
**/Thumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/

**/*.stackdump

# ==========================================================
# Docker
# ==========================================================
**/.docker/
**/docker-data/
**/docker-volumes/
**/postgres-data/
**/redis-data/
**/dump.rdb

# ==========================================================
# Logs
# ==========================================================
**/*.log
**/logs/
**/log/

# ==========================================================
# Environment Files
# ==========================================================
**/.env
**/.env.*
*.env

!.env.example
!*.env.example
!.env.example.*
!**/.env.example*

# ==========================================================
# Temporary Files
# ==========================================================
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~

**/.tmp/
**/tmp/
**/temp/
**/.temp/

# ==========================================================
# Build Outputs & Generated Files
# ==========================================================
**/generated/
**/generated-sources/
**/generated-test-sources/
**/gen/

**/public/build/

**/.next/
**/.nuxt/
**/.output/

**/.gradle/

# ==========================================================
# Test & Coverage Reports
# ==========================================================
**/.coverage/
**/htmlcov/
**/lcov-report/

**/test-results/
**/surefire-reports/
**/failsafe-reports/

**/jacoco/

**/*.exec
**/*.lcov

**/test-results.xml
**/junit.xml

# ==========================================================
# Local Databases & Development State
# ==========================================================
**/*.sqlite
**/*.sqlite3
**/*.db

**/data/
**/.local/

# ==========================================================
# Secrets & Certificates
# ==========================================================
**/*.p12
**/*.jks
**/*.keystore
**/*.pem
**/*.key
**/*.crt

# ==========================================================
# Package Manager Caches
# ==========================================================
**/.m2/repository/
**/.pnpm-store/
**/.yarn/cache/

# ==========================================================
# Keep These Under Version Control
# ==========================================================
!**/mvnw
!**/mvnw.cmd
!**/.mvn/wrapper/**

!**/package-lock.json
!**/pubspec.lock

!**/Dockerfile
!**/Dockerfile.*

!**/docker-compose.yml
!**/docker-compose.yaml

!**/README.md
!**/README*.md
